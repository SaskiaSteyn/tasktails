# Copy to .env.local and fill in. Never commit real secrets.

# ---------------------------------------------------------------------------
# NextAuth (INF-11, NFR-GEN-4)
# ---------------------------------------------------------------------------
# Signs the JWT session cookie. Generate one with:  npx auth secret
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com
#   Authorised redirect URI (local): http://localhost:3000/api/auth/callback/google
# The "Continue with Google" button stays disabled until both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Database (INF-01, AUTH-04)
# ---------------------------------------------------------------------------
# Local development runs the Postgres in docker-compose.yml:
#   docker compose up -d && npx prisma migrate dev
# The value below matches that container. Point it at the real instance for
# staging/production (INF-16).
DATABASE_URL="postgresql://tasktails:tasktails@localhost:5432/tasktails?schema=public"

# ---------------------------------------------------------------------------
# Container / deployment (INF-15)
# ---------------------------------------------------------------------------
# Only needed for `docker compose --profile app up`. Compose reads a `.env`
# beside docker-compose.yml automatically, so that is the place to put these.
# INF-16 expands this section for the real EC2 / managed-Postgres values.

# Published host port for the container. Override when `npm run dev` already
# holds 3000. The container always listens on 3000 internally.
APP_PORT=3000

# The app's public origin. NextAuth cannot infer it behind a proxy, and OAuth
# callbacks go to the wrong host without it.
AUTH_URL=http://localhost:3000
