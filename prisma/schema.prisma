// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A/B study group — assigned once at account creation, permanent (AUTH-5, NFR-TASK-3).
enum AbGroup {
  A
  B
}

/// INF-01. Mirrors the shape of the mock store in src/lib/mock/users.ts, which
/// this model is intended to replace.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// scrypt hash as "salt:derivedKey". Null for OAuth-only accounts.
  passwordHash String?
  abGroup      AbGroup
  createdAt    DateTime @default(now())
  tasks        Task[]
}

/// INF-02.
model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  /// Self-reported tier 1-5 (Trivial/Small/Medium/Large/Epic) — see
  /// economy_system.md's tier table. Trusted input; the anti-spam guardrail
  /// (ECO-02) is the only check against abuse (Requirements §3.2).
  complexityTier Int

  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  subtasks    Subtask[]
}

/// INF-03.
model Subtask {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title       String
  completedAt DateTime?
}

/// Fixed category set per Features.md STOR-03.
enum StoreItemCategory {
  FOOD
  ACCESSORIES
  ANIMALS
  DECORATIONS
}

/// INF-04.
model StoreItem {
  id       String            @id @default(cuid())
  name     String
  category StoreItemCategory

  /// Level gate — see economy_system.md's store gate table (1, 3, 5, 7, 10).
  levelRequired Int
  coinPrice     Int
  imageUrl      String
}
