// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A/B study group — assigned once at account creation, permanent (AUTH-5, NFR-TASK-3).
enum AbGroup {
  A
  B
}

/// INF-01. Mirrors the shape of the mock store in src/lib/mock/users.ts, which
/// this model is intended to replace.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// scrypt hash as "salt:derivedKey". Null for OAuth-only accounts.
  passwordHash String?
  abGroup      AbGroup
  createdAt    DateTime @default(now())
}
